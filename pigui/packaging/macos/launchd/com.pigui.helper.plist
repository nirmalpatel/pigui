<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pigui.helper</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/pigui-helper</string>
    <key>MachServices</key>
    <dict>
        <key>com.pigui.helper</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Adaptive</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.pigui.app</string>
    </array>
</dict>
</plist>
