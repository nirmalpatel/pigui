# Development defaults. Relative paths assume the working directory is pigui/.
# PIGUI uses the in-tree Snort build; no system-wide Snort install is required.

PIGUI_SNORT_BIN=../build/src/snort
PIGUI_SNORT_CONFIG=../lua/snort.lua
PIGUI_SNORT_LUA_PATH=../lua

PIGUI_RUN_DIR=./var/run
PIGUI_LOG_DIR=./var/log
PIGUI_DB_PATH=./var/lib/pigui.db
PIGUI_ALERT_JSON=./var/log/alert_json.txt
PIGUI_SOCKET=./var/run/pigui-daemon.sock

# Phase 1 development uses a captured alert_json fixture instead of live Snort.
PIGUI_FIXTURE_ALERT_JSON=./tests/fixtures/alert_json/valid.jsonl
