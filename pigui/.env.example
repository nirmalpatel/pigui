# Development defaults. Relative paths assume the working directory is pigui/.
# PIGUI uses the in-tree Snort build; no system-wide Snort install is required.

PIGUI_SNORT_BIN=../build/src/snort
PIGUI_SNORT_CONFIG=../lua/snort.lua
PIGUI_SNORT_LUA_PATH=../lua

PIGUI_RUN_DIR=./var/run
PIGUI_LOG_DIR=./var/log
PIGUI_DB_PATH=./var/lib/pigui.db
PIGUI_ALERT_JSON=./var/log/alert_json.txt
PIGUI_SOCKET=./var/run/pigui-daemon.sock

# Phase 1 fixture mode (run-dev.sh). Phase 2 live mode overrides these.
PIGUI_MODE=fixture
PIGUI_FIXTURE_ALERT_JSON=./tests/fixtures/alert_json/valid.jsonl

# Live capture (run-live.sh). Snort must run with sudo for BPF access.
PIGUI_SNORT_INTERFACE=en0
PIGUI_SNORT_LOG_DIR=./var/log/snort
PIGUI_SNORT_CONFIG_DIR=./var/snort
PIGUI_EXTRACTOR_JSON=./var/log/snort/file_connector_pigui_transmit
PIGUI_SNORT_PIDFILE=./var/log/snort/snort.pid
PIGUI_SNORT_CONTROL_SOCKET=./var/run/snort.sock
PIGUI_PROCESS_POLL_MS=1000
PIGUI_LIVE_DB_PATH=./var/lib/pigui-live.db
